# ==== WAJIB DIISI ====

# Private key wallet yang akan dipakai swap (JANGAN PERNAH dibagikan / commit ke git!)
# Format: 64 karakter hex, boleh pakai awalan 0x atau tidak
PRIVATE_KEY=

# RPC endpoint Soneium mainnet (chain id 1868). Bisa pakai default publik di bawah
# atau ganti dengan RPC privat (Alchemy/QuickNode/dll) biar lebih stabil.
RPC_URL=https://rpc.soneium.org

# API key Uniswap Trading API (WAJIB, gratis, daftar di https://hub.uniswap.org/ atau
# https://docs.uniswap.org/api/trading/quick-start -> request API key).
# Script tidak bisa jalan tanpa ini karena dipakai untuk ambil quote & calldata swap V4.
UNISWAP_API_KEY=UwAJ8XnIP9kyet4mQcKc7cwWT1jvJ0A8MmnX8p_jrQM

# ==== OPSIONAL ====

# Slippage awal (persen). Script mulai dari nilai ini, lalu naik otomatis kalau quote/swap gagal.
SLIPPAGE_START=0.05
# Batas atas slippage (persen) supaya tidak kebablasan jika market kurang likuid.
SLIPPAGE_MAX=1.0

# Jadwal cron (format standar cron). Default: setiap hari jam 00:00 (tiap 24 jam)
CRON_SCHEDULE=0 0 * * *

# Set "true" untuk mencetak request/response mentah dari Uniswap Trading API ke console.
# Sangat berguna untuk debugging kalau ada error terkait format transaksi.
DEBUG_UNISWAP=true
